{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-tech-os.local/schemas/v1/resource.schema.json",
  "title": "Resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authority", "language", "difficulty", "access", "status", "checked_at", "locators", "scope", "alternative"],
  "properties": {
    "id": {"type": "string", "pattern": "^resource\\."},
    "title": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "difficulty": {"type": "string", "minLength": 1},
    "access": {"type": "string", "minLength": 1},
    "status": {"enum": ["active_needs_recheck", "rolling_needs_recheck", "deprecated", "withdrawn"]},
    "checked_at": {"type": "string", "format": "date"},
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"const": "url"},
          "value": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "alternative": {"type": "string", "minLength": 1}
  }
}

