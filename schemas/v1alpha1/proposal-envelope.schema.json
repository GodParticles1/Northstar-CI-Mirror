{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:personal-tech-os:northstar:proposal-envelope:v1alpha1",
  "title":"Northstar ProposalEnvelope v1alpha1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","contract_version","proposal_id","proposal_revision","producer_repository","producer_revision","proposal_type","source_proposal_ref","decision_ref","evidence_refs","created_at","compatibility","canonical_payload_fingerprint"],
  "properties":{
    "schema_version":{"const":"northstar.proposal-envelope/v1alpha1"},
    "contract_version":{"const":"northstar.beacon-proposal/v1alpha1"},
    "proposal_id":{"type":"string","pattern":"^nsp_[a-z0-9][a-z0-9._-]{2,63}$"},
    "proposal_revision":{"type":"integer","minimum":1},
    "producer_repository":{"const":"GodParticles1/Beacon"},
    "producer_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "proposal_type":{"enum":["TECHNOLOGY_PROPOSAL","LEARNING_RECOMMENDATION","REPOSITORY_DOMAIN_PROPOSAL","PRODUCT_OPPORTUNITY"]},
    "source_proposal_ref":{"$ref":"urn:personal-tech-os:northstar:proposal-ref:v1alpha1"},
    "decision_ref":{"$ref":"#/$defs/DecisionRef"},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/EvidenceRef"}},
    "created_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "compatibility":{"type":"object","additionalProperties":false,"required":["compatibility_version","producer_schema_version"],"properties":{"compatibility_version":{"const":"northstar.beacon-proposal/v1alpha1"},"producer_schema_version":{"const":"beacon.proposal-draft/v1alpha1"}}},
    "canonical_payload_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "$defs":{
    "DecisionRef":{"type":"object","additionalProperties":false,"required":["repository","object_type","object_id","object_contract_version","producer_revision"],"properties":{"repository":{"const":"GodParticles1/Beacon"},"object_type":{"const":"Decision"},"object_id":{"type":"string","pattern":"^dec_[a-z0-9][a-z0-9._-]{2,63}$"},"object_contract_version":{"const":"beacon.decision/v1alpha1"},"producer_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "EvidenceRef":{"type":"object","additionalProperties":false,"required":["repository","object_type","object_id","object_contract_version","producer_revision"],"properties":{"repository":{"const":"GodParticles1/Beacon"},"object_type":{"enum":["Source","Signal","TechnologyCandidate","Evaluation","Decision"]},"object_id":{"type":"string","pattern":"^(src|sig|tech|eval|dec)_[a-z0-9][a-z0-9._-]{2,63}$"},"object_contract_version":{"type":"string","pattern":"^beacon\\.[a-z-]+/v1alpha1$"},"producer_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"}}}
  }
}
