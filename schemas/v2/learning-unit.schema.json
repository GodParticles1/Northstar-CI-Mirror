{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-tech-os.local/schemas/v2/learning-unit.schema.json",
  "title": "Knowledge Unit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "owner_repository",
    "revision",
    "status",
    "title",
    "objective",
    "prerequisites",
    "resources",
    "exercise",
    "project_task",
    "acceptance",
    "evidence_target",
    "refresh",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "id": {
      "type": "string",
      "pattern": "^(forge|cortex|nimbus)\\.unit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "owner_repository": {
      "enum": [
        "GodParticles1/Forge",
        "GodParticles1/Cortex",
        "GodParticles1/Nimbus"
      ]
    },
    "revision": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["DRAFT", "FINAL_REVIEW", "FROZEN", "DEPRECATED"]
    },
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "https://personal-tech-os.local/schemas/v2/learning-refs.schema.json#/$defs/learningUnitRef"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://personal-tech-os.local/schemas/v2/learning-refs.schema.json#/$defs/resourceRef"
      },
      "uniqueItems": true
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "deliverables"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "project_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": {"enum": ["exercise", "practice", "project", "lab"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence_target": {
      "$ref": "https://personal-tech-os.local/schemas/v2/learning-refs.schema.json#/$defs/evidenceRef"
    },
    "experiment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://personal-tech-os.local/schemas/v2/learning-refs.schema.json#/$defs/experimentRef"
      },
      "uniqueItems": true,
      "default": []
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "review_after", "triggers"],
      "properties": {
        "checked_at": {"type": "string", "format": "date"},
        "review_after": {"type": "string", "format": "date"},
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
